  },
  "dependencies": {
    "hono": "^4.12.32",
    "htmx.org": "^2.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
